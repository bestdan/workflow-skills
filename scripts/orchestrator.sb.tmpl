;; orchestrator.sb.tmpl — sandbox-exec (Seatbelt) profile TEMPLATE for the
;; auto-pilot detached orchestrator. Rendered by scripts/spawn-orchestrator.sh
;; (render-profile): the placeholder tokens below (each on its own line,
;; delimited by double-at signs) are replaced with concrete allow rules built
;; from the run's resolved paths. This is layer 1 of the two-layer jail
;; (filesystem + process/exec); host-level network egress is layer 2, the
;; detached `claude -p`'s own sandbox.network allowlist — see
;; skills/auto-pilot/references/launch-runtime.md "Sandbox profile".
;;
;; Do not hand-edit a rendered copy; change this template + the renderer.

(version 1)
(deny default)

;; --- process basics: the orchestrator must fork, signal itself, read sysctls
;;     and reach the dynamic linker / system services to run at all.
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)

;; --- deny the launchd / LaunchServices job-submission brokers. The exec block
;;     below (toolchain bin dirs) makes /bin/launchctl and /usr/bin/open
;;     reachable; with an unrestricted mach-lookup a permitted binary could ask
;;     launchd (or LaunchServices) to spawn a job OUTSIDE this jail — the spawned
;;     process does NOT inherit the sandbox, so writes/network confinement can't
;;     contain it (a confused-deputy escape). Seatbelt is last-match-wins, so
;;     these denies override the blanket allow above for exactly the control
;;     services that broker an out-of-jail launch, leaving normal mach use intact.
(deny mach-lookup
  (global-name "com.apple.xpc.launchd")
  (global-name "com.apple.coreservices.launchservicesd"))

;; --- network CLASS only (launch-runtime §"Sandbox profile"): Seatbelt gates
;;     network by socket/class, NOT by hostname. Allow outbound as a class and
;;     permit loopback bind so the layer-2 egress proxy (which DOES filter by
;;     host) can run; all hostname allowlisting lives in layer 2, not here.
(allow network-outbound)
(allow network-bind (local ip "localhost:*"))
(allow system-socket)

;; --- reads: BROAD by necessity (v1). The confinement smoke showed a scoped read
;;     list makes programs abort (SIGABRT) — macOS needs *content* read, not just
;;     metadata, to traverse to a writable target, and that traversal crosses
;;     ancestors above any repo/worktree (/Users, /private/var/folders, …). So v1
;;     allows all reads and enforces confinement on the axes that matter: WRITES
;;     (worktrees only, below), EXEC (the allow-listed block below only), and
;;     NETWORK (layer 2).
;;     Reads are still Unix-perm-bounded (a non-root sandboxed process can't read
;;     root/other-user secrets). Narrowing reads (traverse-allow the ancestor chain
;;     of each RO/RW path instead of allow-all) is a tracked follow-up; it must be
;;     re-verified against smoke §1 so it doesn't re-break traversal.
(allow file-read*)
(allow file-write*
  (literal "/dev/null")
  (literal "/dev/tty"))

;; --- read-only: the rest of the repo, other worktrees, and credential stores
;;     (~/.claude, ~/.config/gh, ~/.config/op, coder cred files). [§1 rows 4–5]
@@RO_PATHS@@

;; --- read-write: the run worktree + run-state checkout, worker worktrees, and
;;     $TMPDIR / scratchpad. Writes are worktree-confined by construction. [§1 rows 1–3]
@@RW_PATHS@@

;; --- exec: the resolved coder binaries (literal) plus, when --toolchain or
;;     --exec-dir is used, whole bin dirs (subpath) so the orchestrator can
;;     shell out to the dozens of coreutils/git-core/uv/node/etc. helpers a
;;     real run needs. Exec breadth here is a COARSE guard, not the enforced
;;     wall — WRITES (RW_PATHS, above) and NETWORK (layer 2) are what actually
;;     bound what a permitted binary can do once it runs. [§4]
@@EXEC_PATHS@@

;; --- defense-in-depth on top of the mach-lookup denies above: refuse to exec
;;     the job-submission binaries outright (last-match-wins over the exec allow
;;     block). They live only in non-writable system bin dirs and RW scopes are
;;     never exec-allowed, so a copy can't be staged into an exec-permitted dir —
;;     this deny is therefore complete for the launchctl/open escape vectors.
(deny process-exec
  (literal "/bin/launchctl")
  (literal "/usr/bin/open"))
