<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@DIR@/supervisor.py</string>
    <string>daemon</string>
  </array>
  <!-- REQUIRED, and not redundant with KeepAlive. KeepAlive=true starts the job
       implicitly, so this was invisible until the first keepalive=false install:
       with KeepAlive=false, no RunAtLoad, and no socket/watchpath to launch it on
       demand, launchd loads the job and never starts it (`state = not running`,
       `runs = 0`). The disarmed first-contact procedure was therefore not
       implementable without this key. -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><@KEEPALIVE@/>
  <key>ThrottleInterval</key><integer>@THROTTLE@</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PROBE5_DB</key><string>@DB@</string>
    <key>PROBE5_REPO</key><string>@REPO@</string>
    <key>PROBE5_DOMAIN_MODE</key><string>@DOMAIN_MODE@</string>
    <key>PROBE5_AGENT_UID</key><string>@AGENT_UID@</string>
    <key>PROBE5_RECONCILE_LOG</key><string>@RECONCILE_LOG@</string>
  </dict>
  <key>StandardOutPath</key><string>@RUNDIR@/supervisor.launchd.out</string>
  <key>StandardErrorPath</key><string>@RUNDIR@/supervisor.launchd.err</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
